{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "swarmz",
  "version": "0.16.0",
  "identifier": "dev.swarmz.app",
  "build": {
    "beforeDevCommand": "npm run build:tool:debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tool && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "swarmz",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "files": {
        "MacOS/swarmz-tool": "target/release/swarmz-tool"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRDUwNDRCMzhCMUZDODQKUldTRS9MRTRTd1RWN3kxRUtVVFRrcHpkU3RicTFweXhxanlpMlpuM1g1VHg3SXNGc29Fam1vYjYK",
      "endpoints": [
        "https://github.com/mokesmokane/swarmz/releases/latest/download/latest.json"
      ]
    }
  }
}
