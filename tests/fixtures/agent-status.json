    "expect": { "status": "blocked", "sessionId": "s1", "needs": "permission", "mode": null, "turnEndedAt": null } },
  { "name": "a tool running after the request unblocks",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "UserPromptSubmit", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:09Z", "event": "PermissionRequest", "input": { "session_id": "s1", "tool_name": "Bash", "tool_input": { "command": "npm test" } } },
      { "ts": "2026-09-16T10:00:20Z", "event": "PostToolUse", "input": { "session_id": "s1" } }],
    "expect": { "status": "working", "sessionId": "s1", "needs": null, "mode": null, "turnEndedAt": null } },
  { "name": "an idle prompt is a question",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "UserPromptSubmit", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:30Z", "event": "Notification", "input": { "session_id": "s1", "notification_type": "idle_prompt" } }],
    "expect": { "status": "blocked", "sessionId": "s1", "needs": "question", "mode": null, "turnEndedAt": null } },
  { "name": "a permission prompt notification needs permission",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "UserPromptSubmit", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:30Z", "event": "Notification", "input": { "session_id": "s1", "notification_type": "permission_prompt" } }],
    "expect": { "status": "blocked", "sessionId": "s1", "needs": "permission", "mode": null, "turnEndedAt": null } },
  { "name": "other notifications change nothing",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:30Z", "event": "Notification", "input": { "session_id": "s1", "notification_type": "auth_success" } }],
    "expect": { "status": "idle", "sessionId": "s1", "needs": null, "mode": null, "turnEndedAt": null } },
  { "name": "session end is offline",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "UserPromptSubmit", "input": { "session_id": "s1" } },
