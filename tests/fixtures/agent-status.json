    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "UserPromptSubmit", "input": { "session_id": "s1" } }],
    "expect": { "status": "working", "sessionId": "s1", "needs": null, "mode": null, "turnEndedAt": null } },
  { "name": "stop ends the turn",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "UserPromptSubmit", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:01:00Z", "event": "Stop", "input": { "session_id": "s1" } }],
    "expect": { "status": "idle", "sessionId": "s1", "needs": null, "mode": null, "turnEndedAt": "2026-09-16T10:01:00Z" } },
  { "name": "a permission request blocks",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "UserPromptSubmit", "input": { "session_id": "s1" } },
