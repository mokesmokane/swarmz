[
  { "name": "session start is idle",
    "events": [{ "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1", "source": "startup", "transcript_path": "/t/s1.jsonl" } }],
    "expect": { "status": "idle", "sessionId": "s1", "needs": null, "mode": null, "turnEndedAt": null } },
