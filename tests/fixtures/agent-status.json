    "expect": { "status": "idle", "sessionId": "s1", "needs": null, "mode": "accept edits", "turnEndedAt": null } },
  { "name": "a tool finishing while idle changes nothing",
    "events": [
      { "ts": "2026-09-16T10:00:00Z", "event": "SessionStart", "input": { "session_id": "s1" } },
      { "ts": "2026-09-16T10:00:05Z", "event": "PostToolUse", "input": { "session_id": "s1" } }],
    "expect": { "status": "idle", "sessionId": "s1", "needs": null, "mode": null, "turnEndedAt": null } }
